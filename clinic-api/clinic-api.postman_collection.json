            "url": "{{base_url}}/reset",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    { \"id\": \"s1\", \"provider\": \"Dr Ade\", \"start\": \"2026-12-10T09:00:00Z\", \"end\": \"2026-12-10T09:30:00Z\" },\n    { \"id\": \"s2\", \"provider\": \"Dr Ade\", \"start\": \"2026-12-10T10:00:00Z\", \"end\": \"2026-12-10T10:30:00Z\" },\n    { \"id\": \"s3\", \"provider\": \"Dr Bola\", \"start\": \"2026-12-10T11:00:00Z\", \"end\": \"2026-12-10T11:30:00Z\" },\n    { \"id\": \"s-started\", \"provider\": \"Dr Ade\", \"start\": \"2020-01-01T09:00:00Z\", \"end\": \"2020-01-01T09:30:00Z\" }\n  ]\n}"
