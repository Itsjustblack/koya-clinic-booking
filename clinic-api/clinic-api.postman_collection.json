    {
      "name": "2. GET /slots",
      "item": [
        {
          "name": "List all slots, ordered by start (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has slots array', () => pm.expect(body.slots).to.be.an('array'));",
                  "pm.test('ordered by start ascending', () => {",
                  "  const starts = body.slots.map(s => new Date(s.start).getTime());",
                  "  const sorted = [...starts].sort((a, b) => a - b);",
                  "  pm.expect(starts).to.eql(sorted);",
                  "});",
                  "pm.test('slot has available flag', () => pm.expect(body.slots[0]).to.have.property('available'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": "{{base_url}}/slots"
          }
        },
        {
          "name": "Filter by provider, exact match (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('only matching provider returned', () => {",
                  "  pm.expect(body.slots.every(s => s.provider === 'Dr Ade')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/slots?provider=Dr Ade",
              "host": ["{{base_url}}"],
              "path": ["slots"],
              "query": [{ "key": "provider", "value": "Dr Ade" }]
            }
          }
        },
        {
          "name": "Filter by provider with no matches (200, empty array)",
