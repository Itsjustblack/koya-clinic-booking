    {
      "name": "3. POST /bookings - happy path",
      "item": [
        {
          "name": "Create booking (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('id is 12-char nanoid', () => pm.expect(body.id).to.match(/^[A-Za-z0-9_-]{12}$/));",
                  "pm.test('status is confirmed', () => pm.expect(body.status).to.eql('confirmed'));",
                  "pm.test('name trimmed', () => pm.expect(body.name).to.eql('Ada Obi'));",
                  "pm.test('email trimmed and lowercased', () => pm.expect(body.email).to.eql('ada@example.com'));",
                  "pm.collectionVariables.set('booking_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"s1\",\n  \"name\": \"  Ada Obi  \",\n  \"email\": \"  ADA@EXAMPLE.COM  \"\n}"
            }
